---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Sofía Aguayo | Ingeniera Física y Astrónoma',
	description = 'Portafolio de Sofía Aguayo: ingeniera física y astrónoma trabajando en análisis de datos, machine learning y software científico.'
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<meta name="description" content={description} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;600&family=Inter:wght@400;500;600;700&display=swap"
		/>
	</head>

	<body>
		<div class="stars" aria-hidden="true"></div>
		<div class="glow glow-1" aria-hidden="true"></div>
		<div class="glow glow-2" aria-hidden="true"></div>

		<Header />
		<slot />
		<Footer />
	</body>
</html>

<style is:global>
	:root {
		--bg-dark: #090611;
		--bg-mid: #120a1f;
		--surface: rgba(20, 15, 32, 0.7);
		--surface-line: rgba(200, 180, 255, 0.14);
		--text: #f5f3ff;
		--muted: #cfc4e6;
		--dim: #a396bd;
		--accent: #b58cff;
		--accent-soft: #7c4dff;

		--font-display: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
		--font-body: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;

		--ancho: min(1100px, calc(100% - 3rem));
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	html,
	body {
		margin: 0;
		padding: 0;
		min-height: 100vh;
		width: 100%;
	}

	body {
		position: relative;
		overflow-x: hidden;
		color: var(--text);
		font-family: var(--font-body);
		line-height: 1.6;
		background:
			radial-gradient(circle at 20% 20%, rgba(120, 80, 255, 0.18), transparent 25%),
			radial-gradient(circle at 80% 15%, rgba(255, 120, 220, 0.12), transparent 20%),
			radial-gradient(circle at 50% 80%, rgba(90, 150, 255, 0.1), transparent 22%),
			linear-gradient(180deg, var(--bg-dark) 0%, var(--bg-mid) 45%, var(--bg-dark) 100%);
		background-attachment: fixed;
	}

	h1,
	h2,
	h3 {
		font-family: var(--font-display);
		font-weight: 400;
		letter-spacing: -0.01em;
	}

	a:focus-visible,
	button:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
		border-radius: 4px;
	}

	.stars {
		position: fixed;
		inset: 0;
		pointer-events: none;
		background-image:
			radial-gradient(2px 2px at 20px 30px, rgba(255, 255, 255, 0.9), transparent 50%),
			radial-gradient(1.5px 1.5px at 120px 80px, rgba(255, 255, 255, 0.8), transparent 50%),
			radial-gradient(2px 2px at 220px 180px, rgba(255, 255, 255, 0.7), transparent 50%),
			radial-gradient(1.5px 1.5px at 340px 120px, rgba(255, 255, 255, 0.75), transparent 50%),
			radial-gradient(2px 2px at 500px 220px, rgba(255, 255, 255, 0.8), transparent 50%),
			radial-gradient(1.5px 1.5px at 680px 90px, rgba(255, 255, 255, 0.7), transparent 50%),
			radial-gradient(2px 2px at 800px 260px, rgba(255, 255, 255, 0.85), transparent 50%);
		background-size: 900px 400px;
		opacity: 0.55;
		z-index: 0;
	}

	.glow {
		position: fixed;
		border-radius: 999px;
		filter: blur(70px);
		pointer-events: none;
		z-index: 0;
		opacity: 0.45;
	}

	.glow-1 {
		top: 8%;
		left: 10%;
		width: 250px;
		height: 250px;
		background: rgba(128, 90, 255, 0.22);
	}

	.glow-2 {
		right: 8%;
		bottom: 10%;
		width: 220px;
		height: 220px;
		background: rgba(255, 90, 200, 0.16);
	}

	/* Rótulo de sección reutilizable */
	.seccion {
		position: relative;
		z-index: 1;
		width: var(--ancho);
		margin: 0 auto;
		padding: 6rem 0;
	}

	.seccion-titulo {
		margin: 0 0 0.6rem;
		font-size: clamp(2.2rem, 5vw, 3.2rem);
		line-height: 1.1;
	}

	.seccion-bajada {
		margin: 0 0 3rem;
		max-width: 60ch;
		color: var(--muted);
	}

	.etiqueta {
		margin: 0 0 1rem;
		color: var(--accent);
		font-size: 0.76rem;
		font-weight: 600;
		letter-spacing: 0.22em;
		text-transform: uppercase;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}

		*,
		*::before,
		*::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
		}
	}
</style>
