<style>
	.galaxia {
		position: absolute;
		right: 0;
		top: 50%;
		width: min(44vw, 540px);
		aspect-ratio: 1;
		transform: translateY(-50%);
		z-index: 2;
	}

	svg {
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	.rueda {
	transform-box: view-box;
	transform-origin: center;
	animation: girar 55s linear infinite;
	will-change: transform;
	}

	@keyframes girar {
		to {
			transform: rotate(360deg);
		}
	}

	.brazos path {
		fill: none;
		stroke: rgba(197, 165, 255, 0.4);
		stroke-width: 7;
		stroke-linecap: round;
		filter: blur(3px);
	}

	.puntos circle {
		fill: #efe6ff;
	}

	.halo circle {
		fill: rgba(220, 205, 255, 0.75);
		animation: titilar 4s ease-in-out infinite;
	}

	.halo circle:nth-child(3n) {
		animation-delay: 1.3s;
	}

	.puntos circle {
	fill: #efe6ff;
	animation: titilar 3.5s ease-in-out infinite;
	transform-box: fill-box;
	transform-origin: center;
}

.halo circle {
	fill: rgba(220, 205, 255, 0.75);
	animation: titilar 2.8s ease-in-out infinite;
	transform-box: fill-box;
	transform-origin: center;
}

/* Distintos retrasos para que no titilen todas juntas */

.puntos circle:nth-child(3n) {
	animation-delay: 0.7s;
}

.puntos circle:nth-child(3n + 1) {
	animation-delay: 1.5s;
}

.puntos circle:nth-child(4n) {
	animation-delay: 2.2s;
}

.halo circle:nth-child(3n) {
	animation-delay: 0.9s;
}

.halo circle:nth-child(3n + 1) {
	animation-delay: 1.8s;
}

.puntos circle {
	fill: #efe6ff;
	animation: titilar 3.5s ease-in-out infinite;
	transform-box: fill-box;
	transform-origin: center;
}

.halo circle {
	fill: rgba(220, 205, 255, 0.75);
	animation: titilar 2.8s ease-in-out infinite;
	transform-box: fill-box;
	transform-origin: center;
}

/* Distintos retrasos para que no titilen todas juntas */

.puntos circle:nth-child(3n) {
	animation-delay: 0.7s;
}

.puntos circle:nth-child(3n + 1) {
	animation-delay: 1.5s;
}

.puntos circle:nth-child(4n) {
	animation-delay: 2.2s;
}

.halo circle:nth-child(3n) {
	animation-delay: 0.9s;
}

.halo circle:nth-child(3n + 1) {
	animation-delay: 1.8s;
}

.halo circle:nth-child(5n) {
	animation-delay: 2.5s;
}

@keyframes titilar {
	0%,
	100% {
		opacity: 0.25;
		transform: scale(0.85);
	}

	50% {
		opacity: 1;
		transform: scale(1.35);
	}
}

	.nucleo {
		animation: latir 7s ease-in-out infinite;
		transform-origin: 250px 250px;
	}

	@keyframes latir {
		0%,
		100% {
			opacity: 0.85;
			transform: scale(1);
		}

		50% {
			opacity: 1;
			transform: scale(1.06);
		}
	}

	.etiqueta-fondo {
		position: absolute;
		right: 8%;
		bottom: 6%;
		margin: 0;
		color: rgba(185, 150, 255, 0.62);
		font-size: 0.65rem;
		letter-spacing: 0.2em;
	}

	@media (max-width: 900px) {
		.galaxia {
			right: -18%;
			width: 65vw;
			opacity: 0.3;
		}
	}
</style>