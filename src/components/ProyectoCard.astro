---
import type { Proyecto } from '../data/proyectos';

interface Props {
	proyecto: Proyecto;
	indice: number;
}

const { proyecto, indice } = Astro.props;
const numero = String(indice + 1).padStart(2, '0');
---

<article class="tarjeta">
	<div class="cabecera">
		<span class="numero" aria-hidden="true">{numero}</span>
		<div class="meta">
			<span class="periodo">{proyecto.periodo}</span>
			<span class="separador" aria-hidden="true">·</span>
			<span class="contexto">{proyecto.contexto}</span>
		</div>
	</div>

	<h3>{proyecto.titulo}</h3>

	<p class="resumen">{proyecto.resumen}</p>

	<details>
		<summary>Cómo lo hice</summary>
		<ul>
			{proyecto.detalles.map((d) => <li>{d}</li>)}
		</ul>
	</details>

	<ul class="tags">
		{proyecto.tags.map((t) => <li>{t}</li>)}
	</ul>

	{
		proyecto.enlace && (
			<a class="enlace" href={proyecto.enlace.href} target="_blank" rel="noopener noreferrer">
				{proyecto.enlace.texto}
				<span aria-hidden="true">→</span>
			</a>
		)
	}
</article>

<style>
	.tarjeta {
		position: relative;
		padding: 2rem;
		border: 1px solid var(--surface-line);
		border-radius: 18px;
		background: var(--surface);
		transition:
			border-color 0.25s ease,
			transform 0.25s ease;
	}

	.tarjeta:hover {
		border-color: rgba(200, 180, 255, 0.32);
		transform: translateY(-3px);
	}

	.cabecera {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.numero {
		font-family: var(--font-display);
		font-size: 1.6rem;
		color: rgba(181, 140, 255, 0.55);
		line-height: 1;
	}

	.meta {
		color: var(--dim);
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.separador {
		margin: 0 0.4rem;
	}

	h3 {
		margin: 0.8rem 0 0.9rem;
		font-size: 1.7rem;
		line-height: 1.2;
		color: var(--text);
	}

	.resumen {
		margin: 0;
		color: var(--muted);
		font-size: 0.97rem;
	}

	details {
		margin-top: 1.3rem;
		border-top: 1px solid rgba(200, 180, 255, 0.1);
		padding-top: 1rem;
	}

	summary {
		cursor: pointer;
		color: var(--accent);
		font-size: 0.85rem;
		font-weight: 600;
		list-style: none;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary::before {
		content: '+';
		display: inline-block;
		font-size: 1rem;
		line-height: 1;
		transition: transform 0.2s ease;
	}

	details[open] summary::before {
		content: '−';
	}

	details ul {
		margin: 1rem 0 0;
		padding-left: 1.1rem;
		color: var(--muted);
		font-size: 0.92rem;
	}

	details ul li {
		margin-bottom: 0.6rem;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
	}

	.tags li {
		padding: 0.3rem 0.7rem;
		border: 1px solid rgba(200, 180, 255, 0.18);
		border-radius: 999px;
		color: var(--dim);
		font-size: 0.74rem;
		letter-spacing: 0.04em;
	}

	.enlace {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		margin-top: 1.5rem;
		color: var(--accent);
		text-decoration: none;
		font-size: 0.88rem;
		font-weight: 600;
	}

	.enlace:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	@media (max-width: 620px) {
		.tarjeta {
			padding: 1.5rem;
		}

		h3 {
			font-size: 1.45rem;
		}
	}
</style>
